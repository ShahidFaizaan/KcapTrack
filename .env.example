# KCapTrack Environment Configuration Example

# Application
APP_NAME=KCapTrack
APP_VERSION=1.0.0
DEBUG=True

# Database (PostgreSQL default, or SQLite for zero-config quickstart)
# PostgreSQL async / sync:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kcaptrack
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@localhost:5432/kcaptrack

# SQLite alternative for zero-config local testing:
# DATABASE_URL=sqlite+aiosqlite:///./kcaptrack.db
# DATABASE_URL_SYNC=sqlite:///./kcaptrack.db

# Security & JWT
SECRET_KEY=generate-a-strong-random-key-with-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Computer Vision / YOLO
YOLO_WEIGHTS_PATH=models/yolov8n.pt
YOLO_CONFIDENCE_THRESHOLD=0.40
UPLOAD_DIR=uploads

# Google Gemini Vision API (Optional - free 1500 req/day from https://aistudio.google.com/app/apikey)
# Enables deep multimodal food recognition for all regional cuisines (Dosa, Biryani, Curries, etc.)
GEMINI_API_KEY=

# USDA FoodData Central (Optional)
# USDA_API_KEY=your_usda_api_key_here
# USDA_BASE_URL=https://api.nal.usda.gov/fdc/v1
